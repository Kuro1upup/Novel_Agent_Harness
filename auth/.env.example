# Auth Service Configuration
# 复制为 .env 后即可直接 go run ./cmd/server 启动

# 服务端口
SERVER_PORT=8001

# 本地个人部署默认只开放邮箱注册；已有手机号账户仍可登录
PHONE_REGISTRATION_ENABLED=false
# 仅本地单人部署启用；内部接口仍要求 AUTH_INTERNAL_API_KEY
LOCAL_ACCOUNT_BOOTSTRAP_ENABLED=true

# JWT 密钥（生产环境请更换为强随机字符串）
JWT_SECRET=dev-jwt-secret-change-in-production

# MySQL 连接
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=novel_auth
MYSQL_ROOT_USER=mysql-root-user-change-in-production
MYSQL_ROOT_PASSWORD=mysql-root-password-change-in-production
MYSQL_USER=novel_agent
MYSQL_PASSWORD=mysql-password-change-in-production

# MinIO 对象存储（用户头像）
MINIO_ENDPOINT=localhost:20000
MINIO_ACCESS_KEY=minio-access-key-change-in-production
MINIO_SECRET_KEY=minio-secret-key-change-in-production
MINIO_SECURE=false
MINIO_BUCKET=novel-auth

# Billing 服务地址（新用户注册后自动初始化余额）
BILLING_SERVICE_URL=http://billing:8002
BILLING_INTERNAL_API_KEY=internal-api-key-change-in-production

# Auth 内部管理接口，仅供本地 bootstrap 等内部调用使用
AUTH_INTERNAL_API_KEY=auth-internal-api-key-change-in-production

# ── 腾讯云短信（SMS）配置 ──
# 短信应用 ID
SMS_APP_ID=sms-app-id-change-in-production
# 短信应用 Key
SMS_APP_KEY=sms-app-key-change-in-production
# 短信签名（需在腾讯云短信控制台审核通过后填写）
SMS_SIGN_NAME=sms-sign-name-change-in-production
# 短信模板 ID（需在腾讯云短信控制台审核通过后填写）
SMS_TEMPLATE_ID=template-id-change-in-production

# ── 腾讯云邮件（SES）配置 ──
# 腾讯云 API 密钥 ID（CAM 控制台获取）
TENCENT_SECRET_ID=tencent-secret-id-change-in-production
# 腾讯云 API 密钥 Key
TENCENT_SECRET_KEY=tencent-secret-key-change-in-production
# SES 区域
SES_REGION=ap-guangzhou

# ── 前端地址 ──
FRONTEND_URL=http://localhost:5173
