# Billing Service Configuration
# 复制为 .env 后即可直接 go run ./cmd/server 启动

# 服务端口
SERVER_PORT=8002

# JWT 密钥（需与 auth 服务一致）
JWT_SECRET=dev-jwt-secret-change-in-production

# MySQL 连接（与 auth 使用同一实例，但使用独立数据库和独立账号）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=novel_billing
MYSQL_ROOT_USER=mysql-root-user-change-in-production
MYSQL_ROOT_PASSWORD=mysql-root-password-change-in-production
MYSQL_USER=novel_billing
MYSQL_PASSWORD=mysql-password-change-in-production

# Redis（消费 LLM 用量事件流）
REDIS_HOST=localhost
REDIS_PORT=20005
REDIS_PASSWORD=redis-password-change-in-production
REDIS_DATABASE=1

# 内部 API Key（供 auth 调用内部端点）
BILLING_INTERNAL_API_KEY=internal-api-key-change-in-production

# 管理员充值密码
ADMIN_PASSWORD=admin-password-change-in-production
