APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/novel-harness.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=novel_agent
DATABASE_ROOT_USER=root
DATABASE_ROOT_PASSWORD=change_me
DATABASE_USER=novel_agent
DATABASE_PASSWORD=change_me

AUTH_REQUIRED=true
AUTH_SERVICE_URL=http://localhost:8001
AUTH_REQUEST_TIMEOUT_SECONDS=5
AUTH_DATABASE_NAME=novel_auth
PHONE_REGISTRATION_ENABLED=false
LOCAL_ACCOUNT_BOOTSTRAP_ENABLED=true

BILLING_ENABLED=true
BILLING_REQUIRED=true
BILLING_SERVICE_URL=http://localhost:8002
BILLING_INTERNAL_API_KEY=internal-api-key-change-in-production
BILLING_REQUEST_TIMEOUT_SECONDS=5
BILLING_DATABASE_NAME=novel_billing

MINIO_ENDPOINT=localhost:20000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_SECURE=false
MINIO_BUCKET=novel-agent

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=novel_chunks_qwen_v4_1024

EMBEDDING_PROVIDER=qwen
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
QWEN_API_KEY=

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
LLM_SUPPORTS_JSON_SCHEMA=false
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=https://searxng.dsppt.site

CACHE_PROVIDER=redis
REDIS_HOST=localhost
REDIS_PORT=20005
REDIS_PASSWORD=myredissecret
REDIS_DATABASE=0
REDIS_CACHE_TTL_SECONDS=900

REQUEST_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=2
RESEARCH_FETCH_ENABLED=true
RESEARCH_FETCH_MAX_BYTES=2097152
RESEARCH_FETCH_MAX_SOURCES=5
CONTEXT_MAX_CHARACTERS=24000
CONTEXT_RETRIEVAL_LIMIT=12
WORKFLOW_LEASE_SECONDS=300
WORKFLOW_RETRY_BACKOFF_SECONDS=5
WORKER_POLL_INTERVAL_SECONDS=1
ORIGINALITY_MAX_CONTIGUOUS_CHARS=24
ORIGINALITY_MAX_NGRAM_OVERLAP=0.35
MAX_UPLOAD_BYTES=20971520
CORS_ORIGINS=http://localhost:5173
